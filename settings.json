{
  "api_endpoint": "http://localhost:1234/v1",
  "model": "openai/gpt-oss-20b",
  "sandbox_root": "./sandbox",
  "max_file_size_mb": 10,
  "temperature": 0.7,
  "max_tokens": 2000,
  "allowed_commands": {
    "nest": "nest generate module {}",
    "test": "npm test -- {}",
    "lint": "npm run lint -- {}",
    "build": "npm run build",
    "git_add": "git add {}",
    "git_commit": "git commit -m '{}'",
    "git_status": "git status"
  },
  "allowed_command_prefixes": [
    "npm",
    "git",
    "npx"
  ],
  "forbidden_patterns": [
    "rm -rf /",
    "sudo",
    "||",
    "&&",
    ";",
    "`",
    "$("
  ]
}